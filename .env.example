LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_TOKENS=8192
# Application setting forwarded as num_gpu. Leave empty for automatic placement.
# Set to 99 only after verifying that this model/context fits entirely in GPU memory.
OLLAMA_GPU_LAYERS=
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=90
DOCUMENT_TIMEOUT_SECONDS=600
RESEARCH_MODE=FAST_RESEARCH_MODE
SUMMARY_OUTPUT_TOKENS=256
SUMMARY_CONTEXT_TOKENS=8192
FAST_EVIDENCE_LIMIT=4
# Never enabled by the presence of an API key alone.
ALLOW_PAID_API=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LOCAL_TEST_MODE=false
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_TTL_SECONDS=2592000
# Optional; recommended for a higher OpenAlex quota. Obtain from openalex.org/settings/api.
OPENALEX_API_KEY=
CHUNK_TOKENS=2000
MAX_CHUNKS=32
MAX_QUESTIONS=5
PAPERS_PER_QUESTION=3

# Optional persistent corpus workspace. No model is needed for ingestion/keyword search.
CORPUS_PAGES_PER_RUN=20
CORPUS_DOCUMENTS_PER_RUN=5
CORPUS_SECONDS_PER_RUN=30
CORPUS_MAX_PDF_BYTES=52428800
CORPUS_MAX_PAGES=2000
CORPUS_MAX_PAGE_CHARS=100000
CORPUS_PASSAGE_CHARS=1200
CORPUS_OVERLAP_CHARS=120
CORPUS_EMBEDDING_MODEL=all-minilm:latest
CORPUS_EMBEDDING_CONTEXT=512
CORPUS_EMBEDDINGS_PER_RUN=32
CORPUS_RETRIEVAL_LIMIT=10
CORPUS_VECTOR_SCAN_LIMIT=50000
