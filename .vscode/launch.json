{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv-swarm/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "name": "Research Swarm (Streamlit)",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv-swarm/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "name": "Research Swarm (MCP stdio)",
            "module": "research_swarm.mcp_server",
            "args": [
                "--pdf-root",
                "${workspaceFolder}/deCitit"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv-swarm/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "name": "Research Swarm (Tests)",
            "module": "pytest",
            "args": [
                "-q",
                "-p",
                "no:cacheprovider",
                "--basetemp=.runtime/pytest-vscode"
            ]
        }
    ]
}
