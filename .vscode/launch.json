{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Research Swarm (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv-swarm/Scripts/python.exe",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Summarize Sample Article",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "${workspaceFolder}/sample_article.txt"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Summarize Active File in Editor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Interactive Article Summarizer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_article_summarizer.py",
            "console": "integratedTerminal"
        }
    ]
}
